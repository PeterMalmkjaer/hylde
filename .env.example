# Hylde-appen skriver denne fil til ~/.hylde/.env.
# Du behøver ikke redigere den selv. Felterne her er de samme som i appen.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Valgfri. Bruges kun af `hylde-refresh`, ikke af hvert spørgsmål.
# OPENROUTER_API_KEY=sk-or-...

# Lokal OpenAI-kompatibel server (Ollama eller llama-server).
# HYLDE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# llama.cpp: http://127.0.0.1:8080/v1
# HYLDE_LOCAL_MODEL=qwen2.5-coder:7b
# HYLDE_LOCAL_API_KEY=ollama

# HYLDE_DATA_DIR=~/.hylde
# HYLDE_LOG_LEVEL=INFO
# HYLDE_DRY_RUN=0
