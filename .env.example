# Hylde-appen skriver denne fil til ~/.hylde/.env.
# Du behøver ikke redigere den selv. Felterne her er de samme som i appen.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Valgfri. Bruges kun af `hylde-refresh`, ikke af hvert spørgsmål.
# OPENROUTER_API_KEY=sk-or-...

# Ollama på maskinen. Kan køre samtidig med llama.cpp.
# HYLDE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# HYLDE_LOCAL_MODEL=qwen2.5-coder:7b
# HYLDE_LOCAL_API_KEY=ollama

# llama.cpp, slået fra indtil du vælger en model.
# HYLDE_LLAMA_ENABLED=0
# HYLDE_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# HYLDE_LLAMA_MODEL=

# Ollama Cloud. Egen nøgle, ikke Anthropic. Vælges kun når du siger cloud.
# OLLAMA_API_KEY=
# HYLDE_OLLAMA_CLOUD_MODEL=

# HYLDE_DATA_DIR=~/.hylde
# HYLDE_LOG_LEVEL=INFO
# HYLDE_DRY_RUN=0
